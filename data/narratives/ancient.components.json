    { "id": "ancient.guardian_relief_pledge", "label": "赈务承诺", "type": "promise", "priority": 5, "directionIds": ["ancient.guardian"], "threadIds": ["ancient.guardian_relief"], "facts": ["你曾答应让受灾之人的姓名不被账册抹去。"], "introHint": "一项救助承诺刚刚落在你身上。", "activeHint": "承诺已牵连具体的人，不能只停在善意。", "escalationHint": "账目与人命同时施压，任何取舍都会留下名字。", "payoffHint": "让旧日的救助承诺得到可见的回应。" },
    { "id": "ancient.guardian_relief_ledger", "label": "赈粮账册", "type": "object", "priority": 4, "directionIds": ["ancient.guardian"], "threadIds": ["ancient.guardian_relief"], "facts": ["账册上的损耗并不完全合乎实情。"], "introHint": "一册有缺口的账目进入视野。", "activeHint": "账目中的空白开始指向具体责任。", "escalationHint": "账册既能救人，也能成为推卸责任的工具。", "payoffHint": "让账册的去处说明谁承担了代价。" },
