    { "id": "ancient.guardian_duty_cost", "label": "家门的代价", "type": "consequence", "priority": 4, "directionIds": ["ancient.guardian"], "threadIds": ["ancient.guardian_relief"], "facts": ["地方人情与家门声誉都在等你把责任归给别人。"], "introHint": "承担责任的代价开始靠近家门。", "activeHint": "名声与责任彼此牵扯。", "escalationHint": "继续追查会让家门也卷入风波。", "payoffHint": "让代价真正落在应当承担的人身上。" },
