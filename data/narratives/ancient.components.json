    { "id": "ancient.ambition_name_vow", "label": "功名的来处", "type": "promise", "priority": 5, "directionIds": ["ancient.ambition"], "threadIds": ["ancient.ambition_name"], "facts": ["你想取得位置，却不愿把名字完全交给污点。"], "introHint": "功名的道路第一次要求你说明自己的底线。", "activeHint": "上升机会开始追问功名的来处。", "escalationHint": "名节和仕途被迫放在同一张秤上。", "payoffHint": "让功名的来处在众人面前得到交代。" },
