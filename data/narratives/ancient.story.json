  "worldCore": {
    "identity": "礼法、门第、官僚、军功、商贸与民间组织共同塑造人生的景朝。身份决定最初入口，却不预先决定人物的终点。",
    "laws": [
      "文书、名分与见证决定权利能否成立",
      "钱粮、人手、交通与消息决定权力能否落地",
      "皇命需要经过官署、地方与具体执行者才能成为现实",
      "公开体面、私人承诺与生存利益经常彼此冲突"
    ],
    "powerStructure": "皇室居于名义中心，文官与宫廷近臣参与中枢决策；地方官署、士族宗族、军镇、商帮、江湖组织、寺观教门和周边政权分别掌握不同资源。",
    "everydayLife": "读书、务农、营生、行旅、婚亲、服役、任事、习艺与交游构成人生；宏大局势通过家宅、街市、官署、军营、商路和寺观抵达人物。",
    "tone": "克制而有张力，既能写日常人情与个人成长，也能写权力翻覆、商路兴衰、江湖恩怨、战火和改朝换代。"
  },
