  "worldCore": {
    "identity": "礼法、门第、官僚、军功与民间生计并存的古代王朝。身份影响入口，却不预先决定一个人的终点。",
    "laws": [
      "文书、名分与见证决定许多权利能否成立",
      "钱粮、人手、路途与消息决定权力能否落地",
      "公开体面与私人承诺经常彼此冲突"
    ],
    "powerStructure": "皇权与朝廷居于名义中心，地方官署、宗族士绅、军镇、商帮和民间网络各自掌握不同资源。",
    "everydayLife": "读书、务农、营生、行旅、婚亲、服役、任事与交游构成人生；宏大局势必须通过这些生活入口抵达人物。",
    "tone": "克制而有张力，既能写日常人情，也能写权力翻覆、战火与改朝换代的震动。"
  },
