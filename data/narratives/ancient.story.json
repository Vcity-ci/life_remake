{
  "version": 9,
  "worldId": "ancient",
  "storyBible": "景朝并非一条预写好的仕途。宗族、官府、皇权、商路、军镇、乡里与流动人群共同塑造生活；人物可以从任何身份进入权力，也可以始终留在权力边缘。案件、政争、战争、经营、情义和远行都是可能发生的故事形态，真正的主线由本局人物最鲜明的欲望、处境与已经发生的选择形成。",
  "styleRules": [
    "以第二人称写景朝人生，让官署、街市、宗祠、军营、驿路与家宅中的细节自然显出身份、礼数和权力关系。",
    "把案情、民生、声名、人情与局势落到人物当下的处境，用交往、任事和实际得失显出各方的利益与能力。",
    "普通岁月可写读书、营生、行旅、交游、守家或职务中的见闻与积累，使人物逐渐认清自己所在的位置。",
    "冲突抵达高处时，呈现人物怎样应对正在发生的事，以及行动造成的成败、关系和处境变化；战事中可见进退与交锋，日常中亦有安稳与喜悦。"
  ],
  "endingGuide": "以人物留下的生路、关系、秩序或未竟代价收束；功业、归处与身后影响都可成为这段人生的余响。",
  "opening": {
    "earlyLife": {
      "maxAge": 3
    }
  },
  "mainlineSkeleton": {
    "premise": "世界提供规律和压力，本局人设、天赋与身世建立长期故事承诺；每段经历从已发生事实生长，而非复刻世界包范例。",
    "opening": "让人物最有辨识度的处境与世界发生真实接触。",
    "pressure": "扩大人物选择的影响范围，使关系、能力与代价改变后续可能。",
    "climax": "让一生积累面对更大尺度的检验，并形成不可忽略的结果。",
    "payoff": "评价这一生实际形成的成就、关系、代价与影响。",
    "goodEndingDirection": "能力、选择和关系共同形成可延续的成果。",
    "badEndingDirection": "失败或代价改变人生方向，但仍承认人物真实走过的道路。"
  },
  "mainlineActs": [
    {
      "id": "ancient.arc.one",
      "label": "故事初潮",
      "prompt": "由本局人物前提决定第一段核心经历，使人物与世界发生真实接触并形成可以继续发展的矛盾。",
      "readinessStage": "opening"
    },
    {
      "id": "ancient.arc.two",
      "label": "命运转流",
      "prompt": "承接本局已有事实、人物与能力，扩大人物选择的影响范围，使新的冲突和代价真正改变生活。",
      "readinessStage": "pressure"
    },
    {
      "id": "ancient.arc.three",
      "label": "此生大势",
      "prompt": "让人物一生积累的能力、关系与代价面对更大尺度的检验，形成足以评价这段人生的结果。",
      "readinessStage": "climax"
    }
  ],
