{
  "version": 9,
  "worldId": "fantasy",
  "storyBible": "这是一个诡异生态、异族文明、宗门传承、城邦商路与修行大道并存的仙途世界。力量可以改变山河，也会留下污染、因果、誓约和资源债。人物既可能幼年便卷入人皇夺舍与天地异变，也可能从微末生活、异族边地、宗门、军旅、商队或荒野开始；世界包提供规律与可能性，不把人生压回引气、挖井和飞升的固定阶梯。",
  "styleRules": [
    "以第二人称铺开诡境、边地、城邦、宗门与行旅中的感官经验，让风物、法器、气息和异象成为人物行动的一部分。",
    "遭遇、探索与战斗重视观察、位置、判断、消耗和余波；力量应在危局、同伴与环境的牵连中显出重量。",
    "修行、交易、守望、从军、传法或越界都可构成生活，人物按自身身份接触宗门、异族、城邦与未知。",
    "高潮让立场、誓约、修为或关系真实改变，并让诡异、承诺和既有代价在人物选择中回响。"
  ],
  "endingGuide": "以人物面对因果、力量、同伴与未知后的去处收束；守望、传承、远行、封印、突破或留下都可形成余响。",
  "opening": {
    "earlyLife": {
      "maxAge": 3
    }
  },
  "mainlineSkeleton": {
    "premise": "世界提供规律和压力，本局人设、天赋与身世建立长期故事承诺；每段经历从已发生事实生长，而非复刻世界包范例。",
    "opening": "让人物最有辨识度的处境与世界发生真实接触。",
    "pressure": "扩大人物选择的影响范围，使关系、能力与代价改变后续可能。",
    "climax": "让一生积累面对更大尺度的检验，并形成不可忽略的结果。",
    "payoff": "评价这一生实际形成的成就、关系、代价与影响。",
    "goodEndingDirection": "能力、选择和关系共同形成可延续的成果。",
    "badEndingDirection": "失败或代价改变人生方向，但仍承认人物真实走过的道路。"
  },
  "mainlineActs": [
    {
      "id": "fantasy.arc.one",
      "label": "故事初潮",
      "prompt": "由本局人物前提决定第一段核心经历，使人物与世界发生真实接触并形成可以继续发展的矛盾。",
      "readinessStage": "opening"
    },
    {
      "id": "fantasy.arc.two",
      "label": "命运转流",
      "prompt": "承接本局已有事实、人物与能力，扩大人物选择的影响范围，使新的冲突和代价真正改变生活。",
      "readinessStage": "pressure"
    },
    {
      "id": "fantasy.arc.three",
      "label": "此生大势",
      "prompt": "让人物一生积累的能力、关系与代价面对更大尺度的检验，形成足以评价这段人生的结果。",
      "readinessStage": "climax"
    }
  ],
