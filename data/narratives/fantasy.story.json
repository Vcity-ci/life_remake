  "worldCore": {
    "identity": "修行文明与诡异生态并存的广阔世界，宗门、异族、城邦、古老存在和天道秩序彼此争夺解释世界的权力。",
    "laws": [
      "力量必须通过功法、媒介、身体、环境或契约显现",
      "诡异和异族拥有自身规律与欲求",
      "境界提升扩大行动尺度，也同步放大因果和敌意"
    ],
    "powerStructure": "宗门与道统掌握传承，城邦和族群掌握人口与资源，异族、禁区和古老存在拥有不同于人间制度的力量。",
    "everydayLife": "修行、采集、交易、巡守、传法、远行、宗门任务和与异族共处构成日常；力量不是脱离生活的数字。",
    "tone": "幽异、辽阔而有行动感；既能写修行生活，也能写秘法对决、族群战争、禁区探索和改天换地。"
  },
