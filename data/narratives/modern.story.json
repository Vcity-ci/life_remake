{
  "version": 9,
  "worldId": "modern",
  "storyBible": "现代都市人生由家庭、教育、工作、迁移、亲密关系、公共制度和个人创造共同组成。学生、求职、升学、婚姻与成就是常见入口而非固定关卡；人物也可能创业、照料家人、转行、远行、创作或拒绝主流答案。本局故事应优先兑现玩家人设中真正想体验的生活命题。",
  "styleRules": [
    "以第二人称贴近当代生活，校园、通勤、家庭、工作空间、线上往来与城市街区都可成为人物感受变化的现场。",
    "让叙事从对话、协作、停顿、消费、时间安排和日常选择中显出关系的亲疏、压力与机会。",
    "普通岁月可以写学习、工作、兴趣、迁移、照料或独处，让成长以技能、习惯、认识和人际余波缓慢沉淀。",
    "重要冲突落在具体生活安排与人的选择上，高潮后保留现实代价、关系变化或新的自我理解。"
  ],
  "endingGuide": "以人物最终的生活方式、关系、工作或创造回望一路选择；安稳、转向、成就和自我认同都可形成余响。",
  "opening": {
    "earlyLife": {
      "maxAge": 3
    }
  },
  "mainlineSkeleton": {
    "premise": "世界提供规律和压力，本局人设、天赋与身世建立长期故事承诺；每段经历从已发生事实生长，而非复刻世界包范例。",
    "opening": "让人物最有辨识度的处境与世界发生真实接触。",
    "pressure": "扩大人物选择的影响范围，使关系、能力与代价改变后续可能。",
    "climax": "让一生积累面对更大尺度的检验，并形成不可忽略的结果。",
    "payoff": "评价这一生实际形成的成就、关系、代价与影响。",
    "goodEndingDirection": "能力、选择和关系共同形成可延续的成果。",
    "badEndingDirection": "失败或代价改变人生方向，但仍承认人物真实走过的道路。"
  },
