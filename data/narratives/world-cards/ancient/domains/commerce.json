    {
      "id": "ancient.domain.commerce.guild_competition",
      "title": "行会、经营与特许",
      "kind": "world_rule",
      "contextRole": "knowledge",
      "content": "普通货物可由商户自行经营。盐铁等官营品类与军器贸易另受特许，许可限定经营者、货类和范围，由相关官署授予或收回。\n\n行会成员可使用本会共用的仓储、运输与同业担保，也承担约定的共同费用。会外经营仍可进行，但不享有这些共有资源。商户自己的货物与铺产归其所有，共同出资的资产按合伙约定归属；退出行会不自动转让私人产业。",
      "priority": 75,
      "placement": "scenario",
      "activation": { "keys": ["行会", "同业", "经营", "铺面", "特许", "商户"], "scanDepth": 5, "tasks": ["origin", "planning"] }
